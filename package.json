{
  "name": "ofg",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "clean": "node tools/clean-dist.mjs",
    "setup:emscripten": "node tools/setup-emscripten.mjs",
    "setup:dawn": "node tools/setup-dawn.mjs",
    "setup:llvm": "node tools/setup-llvm.mjs",
    "setup:ninja": "node tools/setup-ninja.mjs",
    "build:wasm": "node tools/build-cpp-wasm.mjs",
    "build": "npm run clean && npm run build:wasm && tsc -p tsconfig.app.json",
    "package:site": "npm run build && npm run package:site:from-build",
    "package:site:from-build": "node tools/package-site.mjs",
    "build:cloudflare": "node tools/cloudflare-build.mjs",
    "test:cpp": "node tools/test-cpp.mjs",
    "test:ts": "npm run build && tsc -p tsconfig.test.json && node --import ./dist-test/tests/ts/setupDom.js ./node_modules/mocha/bin/mocha.js \"dist-test/tests/ts/**/*.test.js\"",
    "test": "npm run test:cpp && npm run test:ts",
    "dev": "npm run build && node tools/dev-server.mjs",
    "smoke:browser": "npm run build && node tools/browser-smoke.mjs",
    "smoke:browser:cpp": "npm run build:wasm && node tools/browser-smoke-cpp.mjs",
    "smoke:render": "node tools/smoke-render-cpp.mjs",
    "smoke": "npm run smoke:browser && npm run smoke:render",
    "coverage:cpp": "node tools/cpp-coverage.mjs",
    "coverage:ts": "node tools/ts-coverage.mjs",
    "coverage": "npm run coverage:cpp && npm run coverage:ts"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.0.3",
    "c8": "^11.0.0",
    "happy-dom": "^17.6.3",
    "mocha": "^11.7.6",
    "playwright-core": "^1.61.0",
    "pngjs": "^7.0.0",
    "typescript": "^5.4.5"
  }
}
