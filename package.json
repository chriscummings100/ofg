{
  "name": "ofg",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "clean": "node tools/clean-dist.mjs",
    "build:shaders": "node tools/build-shaders.mjs",
    "check:shaders": "node tools/build-shaders.mjs --check",
    "build": "npm run clean && npm run build:shaders && tsc -p tsconfig.json",
    "test": "npm run build && mocha \"dist/**/*.test.js\"",
    "dev": "npm run build && node tools/dev-server.mjs",
    "smoke:browser": "npm run build && node tools/browser-smoke.mjs",
    "smoke:terrain-debug": "npm run build && node tools/terrain-debug-smoke.mjs",
    "smoke:terrain-seams": "npm run build && node tools/terrain-seam-smoke.mjs",
    "smoke:terrain-presets": "npm run build && node tools/terrain-preset-smoke.mjs",
    "watch": "npm run build:shaders && tsc -p tsconfig.json --watch"
  },
  "devDependencies": {
    "mocha": "^11.7.6",
    "playwright-core": "^1.60.0",
    "pngjs": "^7.0.0",
    "typescript": "^5.4.5"
  }
}
