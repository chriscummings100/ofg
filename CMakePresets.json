{
    "version": 5,
    "configurePresets": [
        {
            "name": "native-debug",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/native",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "BUILD_TESTING": "ON"
            }
        },
        {
            "name": "native-relwithdebinfo",
            "inherits": "native-debug",
            "binaryDir": "${sourceDir}/build/native-relwithdebinfo",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo"
            }
        },
        {
            "name": "native-release",
            "inherits": "native-debug",
            "binaryDir": "${sourceDir}/build/native-release",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "cpu-tests",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/cpu-tests",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "BUILD_TESTING": "ON",
                "OFG_BUILD_APP": "OFF"
            }
        },
        {
            "name": "web",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/web",
            "toolchainFile": "$env{EMSDK}/upstream/emscripten/cmake/Modules/Platform/Emscripten.cmake",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "BUILD_TESTING": "OFF"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "native-debug",
            "configurePreset": "native-debug",
            "targets": [
                "ofg",
                "ofg-render-test",
                "ofg-terrain-test",
                "ofg-terrain-allocation-test",
                "ofg-core-test"
            ]
        },
        {
            "name": "native-relwithdebinfo",
            "inherits": "native-debug",
            "configurePreset": "native-relwithdebinfo"
        },
        {
            "name": "native-release",
            "inherits": "native-debug",
            "configurePreset": "native-release"
        },
        {
            "name": "cpu-tests",
            "configurePreset": "cpu-tests",
            "targets": [
                "ofg-core-test",
                "ofg-terrain-test",
                "ofg-terrain-allocation-test"
            ]
        },
        {
            "name": "web",
            "configurePreset": "web",
            "targets": [
                "ofg-web"
            ]
        }
    ],
    "testPresets": [
        {
            "name": "native-debug",
            "configurePreset": "native-debug",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "native-relwithdebinfo",
            "inherits": "native-debug",
            "configurePreset": "native-relwithdebinfo"
        },
        {
            "name": "native-release",
            "inherits": "native-debug",
            "configurePreset": "native-release"
        },
        {
            "name": "cpu-tests",
            "configurePreset": "cpu-tests",
            "output": {
                "outputOnFailure": true
            }
        }
    ]
}
